# ─────────────────────────────────────────────────────────────
# Skill Swap — Backend environment variables
# Copy this file to .env and fill in your actual secrets.
# DO NOT commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────────

# Server Configuration
PORT=8000
FRONTEND_URL=http://localhost:5173

# Database & Authentication
MONGODB_URI=mongodb://your_mongodb_connection_string
JWT_SECRET=your_jwt_secret_key

# Third-Party APIs
GEMINI_API_KEY=your_gemini_api_key

# Cloudinary (Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP — Email Notifications (e.g., Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=Skill Swap
SMTP_FROM_EMAIL=your-email@gmail.com
CONTACT_RECEIVER_EMAIL=your-email@gmail.com
