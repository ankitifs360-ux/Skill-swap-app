# ─────────────────────────────────────────────────────────────
# Skill Swap — Frontend environment variables (Vite)
# Copy this file to .env and fill in the values.
# All variables MUST start with VITE_ to be exposed to the browser.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Base URL of your Express backend
# Local dev:  http://localhost:8000
# Production: https://your-render-app.onrender.com  (set in Vercel dashboard)
VITE_API_URL=http://localhost:8000

# Socket.io server URL (usually the same as the API URL)
# Local dev:  http://localhost:8000
# Production: https://your-render-app.onrender.com  (set in Vercel dashboard)
VITE_SOCKET_URL=http://localhost:8000
